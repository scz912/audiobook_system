# Copy the values you need into Railway's service "Variables" tab.
# Do NOT put real secrets in this file — it is committed to git.

APP_NAME="Audiobook for Autism"
APP_ENV=production
APP_KEY=            # run: php artisan key:generate --show  → paste base64:... here
APP_DEBUG=false
APP_URL=            # your Railway URL, e.g. https://your-app.up.railway.app
APP_TIMEZONE=Asia/Kuala_Lumpur

LOG_CHANNEL=stack
LOG_LEVEL=info

# Database — on Railway these come from the MySQL plugin. Reference them as
# ${{ MySQL.MYSQLHOST }} etc. (see RAILWAY_DEPLOY.md).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Run the AI image job inline (no separate worker needed).
QUEUE_CONNECTION=sync

# Store uploads/generated files on the public disk (served under /storage).
FILESYSTEM_DISK=public

SESSION_DRIVER=database
CACHE_STORE=database

# Google Gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
